# 至少 32 个不含空白的 ASCII 字符，请自行生成；不提交真实令牌。
REACH_BRIDGE_TOKEN=
# 与 data/home 所有者一致；在宿主上用 id -u / id -g 查询。
PUID=1000
PGID=1000
REACH_BRIDGE_BIND=127.0.0.1
REACH_BRIDGE_PORT=8080
REACH_BRIDGE_TIMEOUT=60
REACH_BRIDGE_QUEUE_TIMEOUT=2
REACH_BRIDGE_CONCURRENCY=2
REACH_BRIDGE_MAX_OUTPUT_BYTES=2097152

# 可选 WebUI 管理：留空时仍可使用查询 API，但管理功能关闭。
# 必须与查询令牌不同；由管理员在浏览器输入，不交给调用方。
REACH_BRIDGE_ADMIN_TOKEN=
# 填浏览器实际访问的精确 Origin，如 https://reach.example.com，不带路径。
REACH_BRIDGE_ADMIN_ORIGIN=
# 默认要求 HTTPS。仅受控私网确需 HTTP 时显式设 true，凭据将明文传输。
REACH_BRIDGE_ALLOW_INSECURE_HTTP=false
REACH_BRIDGE_ADMIN_TIMEOUT=900

# 仅需原生动作时设 false，不启动浏览器。
REACH_BRIDGE_BROWSER_ENABLED=true
# 仅明确接受降低浏览器隔离保护时设 false；不自动检测或降级。
REACH_BRIDGE_BROWSER_SANDBOX=true
# 标准模式保留此配置；NAS 兼容模式改为 no-new-privileges=true。
REACH_BRIDGE_SECURITY_OPT=seccomp=./docker/chromium-seccomp.json
